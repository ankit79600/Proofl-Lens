# ──────────────────────────────────────────────
# ProofLens Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# PostgreSQL / Supabase connection string
# Supabase format:
#   postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Local storage path for uploaded evidence files
STORAGE_PATH=uploads

# Maximum allowed upload size in megabytes
MAX_FILE_SIZE_MB=10

# Accepted MIME types (JSON array)
ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/gif","image/webp","image/tiff"]

# CORS — origins the frontend is allowed to call from (JSON array)
# Use ["*"] during development; restrict to real origins in production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
